{
  "name": "@tawsela/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Types, enums, constants and formatters shared by the API, the dashboard and the mobile apps.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc",
    "clean": "rm -rf dist",
    "lint": "oxlint src/",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@tawsela/tsconfig": "workspace:*",
    "oxlint": "^1.91.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
