# Copy to .env at the repo root (the only .env: the API, the dashboard and the app all read it).
# Only secrets and values that change between machines live here.
# Fixed rules (OTP, token lifetimes, rate limits, uploads folder) are in packages/shared/src/constants.ts.

# development on your PC; production on the server (then SMTP_* and CORS_ORIGINS are required, see below).
NODE_ENV=development
PORT=4000
# Proxies in front of the API: 1 behind nginx, so rate limits count each client. 0 when the API is reached directly.
TRUST_PROXY=0
# Browser origins allowed to call the API, comma-separated. Empty: any origin in development, NONE in production.
# Production example: CORS_ORIGINS=https://dashboard.example.com
CORS_ORIGINS=

# Database (MySQL 8): mysql://USER:PASSWORD@HOST:3306/DATABASE
# Create the database once, then from apps/api: pnpm db:migrate, and pnpm db:seed for try-out data.
DATABASE_URL=mysql://root:password@localhost:3306/tawsela

# Dashboard (Next.js exposes only NEXT_PUBLIC_* to the browser)
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
# Mobile (Expo exposes only EXPO_PUBLIC_* to the app). A phone cannot reach "localhost" on your PC:
# use the PC's address on the same Wi-Fi, e.g. http://192.168.1.14:4000/v1 (ipconfig shows it).
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
# Google Maps for Android (Maps SDK for Android). Empty: the map picker shows a stand-in [Open].
GOOGLE_MAPS_API_KEY=

# Auth (generate a long random secret, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=

# Password for the seeded try-out accounts (the seed refuses to run in production)
SEED_PASSWORD=change-me

# Mail server for sign-up, password-reset and email-change codes (no SMS, contract §15.1 #1).
# Gmail: smtp.gmail.com, 465, the address, and a Google app password.
# Development without SMTP_HOST: no email is sent; the API writes the code to its log instead.
# Production: SMTP_HOST, SMTP_USER and SMTP_PASS are required, or the API refuses to start.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Push goes through Expo's push API (contract §15.1 #7). Only needed when push security is on in
# the Expo project. Nothing is sent while NODE_ENV=test.
EXPO_ACCESS_TOKEN=

# Tests use .env.test at the repo root (same keys, NODE_ENV=test), with their own databases, named
# after its DATABASE_URL (which must end in _test; the part before it only ASCII letters, digits and
# _, e.g. feature_cart_test): tawsela_test (API), tawsela_web_test (dashboard) and
# tawsela_mobile_test (app). The tests drop every table in them, so none may be a dev database.
# Create the API one (tawsela_test) yourself once; the dashboard and app tests create theirs.
# The dashboard tests' API listens on NEXT_PUBLIC_API_URL (http://localhost:4001/v1) and the app
# tests' on MOBILE_TEST_API_URL (default http://localhost:4002/v1). A second checkout testing at
# the same time needs its own ports and a name whose three databases overlap none of the other
# checkout's three (tawsela_web_test is not a safe pick next to tawsela_test; tawsela_cr_test with
# 4011 and 4012 is).

# Added when needed: the Firebase file for Android builds (push goes through Expo, #7).
