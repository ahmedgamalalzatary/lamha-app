PORT=4000

# Database
# Example MySQL URL format:
# mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/tawsela

# Dashboard (Next.js exposes only NEXT_PUBLIC_* to the browser)
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
# Mobile (Expo exposes only EXPO_PUBLIC_* to the app)
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
# Google Maps key for Android release builds only (Expo Go needs none). Keep it out of git.
GOOGLE_MAPS_API_KEY=
# Phone pushes on Android builds: the path to the Firebase project's google-services.json.
GOOGLE_SERVICES_JSON=

# Auth (generate a long random secret, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# Sign-in, sign-up and OTP attempts per minute per IP
AUTH_RATE_LIMIT=10

# OTP by SMS (contract §15.1 #1). Without SMS_PROVIDER the API logs the code instead of sending it.
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=59
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# Uploaded images, relative to apps/api. The dev API serves them at /uploads; nginx does in production.
UPLOADS_DIR=uploads

# Optional: Expo's push security token, if "enhanced push security" is on for the Expo project
EXPO_ACCESS_TOKEN=

# Payments (contract §15.1 #2), filled once the provider is chosen
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Password for the seeded demo accounts
SEED_PASSWORD=change-me
